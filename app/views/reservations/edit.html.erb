<div class="d-flex justify-content-center m-5">
  <div>
    <h3>再予約する</h3>

    <div class="mb-4">
      <% if @reservation.room.image.attached? %>
        <%= image_tag @reservation.room.image, style: "width: 700px; height: auto;" %>
      <% else %>
        <%= image_tag "default-image.png", style: "width: 700px; height: auto;" %>
      <% end %>   
    </div>
    
    <div class="d-flex justify-content-between align-items-center" >
      <p class="fs-3"><%= @reservation.room.name %></p>
      <p class="fs-3 fw-bold" style="color: #ff6f59;">￥<%= @reservation.room.price %>～</p>
    </div>
    <p><%= @reservation.room.address %></p>
    <p>⭐⭐⭐⭐⭐</p>
    <p class="fs-5"><%= @reservation.room.description %></p>

    <%= form_with model: @reservation, url: "/reservations/confirm", method: :post, data: { turbo: false } do |f| %>
      <%= f.hidden_field :id %>
      <%= f.hidden_field :room_id %>
      
      <div>
        <p><%= f.label :checkin_at, "チェックイン" %></p>
        <p><%= f.date_field :checkin_at, class: "form-control form-control-lg" %></p>
      </div>

      <div>
        <p><%= f.label :checkout_at, "チェックアウト" %></p>
        <p><%= f.date_field :checkout_at, class: "form-control form-control-lg" %></p>
      </div>

      <div>
        <p><%= f.label :guest_count, "人数" %></p>
        <p><%= f.number_field :guest_count, class: "form-control form-control-lg" %></p>
      </div>

      <%= f.submit "再予約する", class: "form-control form-control-lg text-white", style: "background-color: #ff7f50;" %>

    <% end %>

    <%= link_to "キャンセル", request.referer || root_path, class: "form-control form-control-lg text-center text-decoration-none mt-3" %>
  </div>
</div>
