<div>
  <h1>Potepan Shareでまだ体験したことのない旅をしよう</h1>
  <div>
    <%= form_with url: rooms_path, method: :get do |f| %>
      <%= f.text_field :area, placeholder: "エリア名を入力" %>
      <%= f.submit "検索" %>
    <% end %>
  </div>
</div>

<h1>おすすめのエリア</h1>

<div>
  <%= link_to "東京", rooms_path(area: "東京") %>
  <%= link_to "大阪", rooms_path(area: "大阪") %>
  <%= link_to "京都", rooms_path(area: "京都") %>
  <%= link_to "札幌", rooms_path(area: "札幌") %> 
</div>
