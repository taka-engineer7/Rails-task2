<%= link_to "Potepan Share", "#" %>

<% if user_signed_in? %>
  <div class="dropdown">
    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown">
      <%= image_tag "default_avatar.png", alt: "アバター", size:'50x50' %>
      <span><%= current_user.name %></span>
    </a>

    <ul class="dropdown-menu">
      <li><%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %></li>
      <li><%= link_to "予約済み一覧", reservations_path, class: "dropdown-item" %></li>
      <li><%= link_to "登録済み一覧", rooms_own_path, class: "dropdown-item" %></li>
      <li><%= link_to "アカウント設定", users_account_path, class: "dropdown-item" %></li>
      <li><%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
    </ul>
  </div>

<% else %>
  <div>
    <%= link_to "ログイン", new_user_session_path %>
    <%= link_to "新規登録", new_user_registration_path %>
  </div>
<% end %>
  