<header class="d-flex justify-content-between align-items-center px-5 py-2" style="background-color: #1e1e30"> 
  <%= link_to "Potepan Share", root_path, class: "text-white text-decoration-none fs-1" %>

  <% if user_signed_in? %>
    <div class="dropdown">
      <a href="#" class="dropdown-toggle text-white text-decoration-none" data-bs-toggle="dropdown">
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar, size: '50x50' %>
        <% else %>
          <%= image_tag'default_avatar.png', size: '50x50' %>
        <% end %>
        <span class= "text-white text-decoration-none"><%= current_user.name %></span>
      </a>

      <ul class="dropdown-menu">
        <li><%= link_to "施設の新規登録", new_room_path, class: "dropdown-item" %></li>
        <li><%= link_to "予約済み一覧", reservations_path, class: "dropdown-item" %></li>
        <li><%= link_to "登録済み一覧", rooms_own_path, class: "dropdown-item" %></li>
        <li><%= link_to "アカウント設定", users_account_path, class: "dropdown-item" %></li>
        <li><%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
      </ul>
    </div>

  <% else %>

    <div>
      <%= link_to "ログイン", new_user_session_path, class: "text-white text-decoration-none" %>
      <%= link_to "新規登録", new_user_registration_path, class: "text-white text-decoration-none btn", style: "background-color: #ff7f50;" %>
    </div>

  <% end %>
  </header>

      