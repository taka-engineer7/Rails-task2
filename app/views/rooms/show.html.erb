<%= render "rooms/search", room: @room %>

<div>
  <%= link_to "←戻る", :back %>
  <%= link_to "🖊編集", edit_room_path(@room) %>
</div>

<% if @room.image.attached? %>
  <%= image_tag @room.image, style: "width :150px; height :auto;" %>
<% end %>

<div>
  <%= @room.name %>
  <%= @room.address %>
  <%= @room.price %>
  <%= @room.description %>
</div>

<%= form_with url: "/reservations/confirm", model: @reservation, data: { turbo: false } do |form| %>
  <%= form.hidden_field :room_id, value: @room.id %>
  <div>
    <%= form.label :checkin_at, "チェックイン" %>
    <%= form.date_field :checkin_at %>

    <% if @reservation.errors[:checkin_at].any? %>
      <%= @reservation.errors[:checkin_at].first %>
    <% end %>
  </div>

  <div>
    <%= form.label :checkout_at, "チェックアウト" %>
    <%= form.date_field :checkout_at %>

    <% if @reservation.errors[:checkout_at].any? %>
      <%= @reservation.errors[:checkout_at].first %>
    <% end %>
  </div>

  <div>
    <%= form.label :guest_count, "人数" %>
    <%= form.number_field :guest_count %>

    <% if @reservation.errors[:guest_count].any? %>
      <%= @reservation.errors[:guest_count].first %>
    <% end %>
  </div>

  <div>
    <% if user_signed_in? %>
      <%= form.submit "予約する" %>
    <% else %>
      <%= link_to "ログイン", "/users/sign_in" %>
    <% end %>
  </div>
<% end %>
