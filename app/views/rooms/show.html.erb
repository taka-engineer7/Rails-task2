<div>
  <%= link_to "←戻る", rooms_path %>
  <%= link_to "🖊編集", edit_room_path(@room) %>
</div>

<% if @room.image.attached? %>
  <%= image_tag @room.image %>
<% end %>

<div>
  <%= @room.name %>
  <%= @room.address %>
  <%= @room.price %>
  <%= @room.description %>
</div>

<%= form_with model: @room do |form| %>
  <div>
    <%= form.label :check_in, "チェックイン" %>
    <%= form.date_field :check_in %>
  </div>

  <div>
    <%= form.label :check_out, "チェックアウト" %>
    <%= form.date_field :check_out %>
  </div>

  <div>
    <%= form.label :people_number, "人数" %>
    <%= form.number_field :people_number %>
  </div>

  <%= form.submit "予約する" %>
<% end %>
