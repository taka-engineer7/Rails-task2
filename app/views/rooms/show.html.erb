<%= render "rooms/search", room: @room %>

<div class="p-5 w-100">
  <div class="d-flex justify-content-between">
    <%= link_to "←戻る", request.referer || root_path, class: "text-decoration-none fs-3" %>
    <%= link_to "🖊編集", edit_room_path(@room), class: "text-decoration-none fs-3" %>
  </div>
  
  <div class="d-flex">
    <div>
      <% if @room.image.attached? %>
        <%= image_tag @room.image, style: "width :550px; height :auto;" %>
      <% else %>
        <%= image_tag "default-image.png", style: "width: 550px; height: auto;" %>
      <% end %>
    </div>
    
    <div class="ms-4 p-4 bg-warning-subtle w-100">
      <div>
        <div class="d-flex justify-content-between">
          <span class="fs-3"><%= @room.name %></span>
          <span class="fs-1 fw-bold" style="color: #ff6f59;">￥<%= @room.price %>～</span>
        </div>
        <p><%= @room.address %></p>
        <p>⭐⭐⭐⭐⭐</p>
        <p><%= @room.description %></p>
      </div>

      <%= form_with url: "/reservations/confirm", model: @reservation, data: { turbo: false } do |form| %>
        <%= form.hidden_field :room_id, value: @room.id %>

        <div class="d-flex justify-content-between bg-white p-3">
          <div>
            <p><%= form.label :checkin_at, "チェックイン" %></p>
            <p><%= form.date_field :checkin_at, class: "form-control form-control-lg" %></p>

            <% if @reservation.errors[:checkin_at].any? %>
              <%= @reservation.errors[:checkin_at].first %>
            <% end %>
          </div>

          <div>
            <p><%= form.label :checkout_at, "チェックアウト" %></p>
            <p><%= form.date_field :checkout_at, class: "form-control form-control-lg" %></p>

            <% if @reservation.errors[:checkout_at].any? %>
              <%= @reservation.errors[:checkout_at].first %>
            <% end %>
          </div>

          <div>
            <p><%= form.label :guest_count, "人数" %></p>
            <p><%= form.number_field :guest_count, class: "form-control form-control-lg" %></p>

            <% if @reservation.errors[:guest_count].any? %>
              <%= @reservation.errors[:guest_count].first %>
            <% end %>
          </div>
        </div>

        <div>
          <% if user_signed_in? %>
            <%= form.submit "予約する", class: "form-control form-control-lg text-white mt-4", style: "background-color: #ff7f50;" %>
          <% else %>
            <%= link_to "ログイン", "/users/sign_in", class: "form-control form-control-lg text-white text-decoration-none text-center mt-4", style: "background-color: #ff7f50;" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

</div>