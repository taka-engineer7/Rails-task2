<h1>登録済み一覧</h1>

<table>
  <tr>
    <th>画像</th><th>施設名</th><th>紹介文</th><th>料金</th><th>作成日</th>
  </tr>
  <% @rooms.each do |room| %>
    <tr>
      <td>
        <% if room.image.attached? %>
          <%= image_tag room.image, style: "width: 150px; height: auto;" %>
        <% else %>
          <%= image_tag "default-image.png", style: "width: 150px; height: auto;" %>
        <% end %>
      </td>
      <td><%= link_to room.name, room_path(room) %></td>
      <td><%= room.description %></td>
      <td>￥<%= room.price %>～</td>
      <td><%= room.created_at.strftime("%Y/%m/%d") %></td>
    </tr>
  <% end %>
</table>