<div class="d-flex m-5">
  <div class="me-4">
    <h3>設定</h3>
    <div class="list-group rounded-0 mt-4" style="width: 300px">
      <%= link_to "アカウント", "/users/account", class: "list-group-item list-group-item-action py-4 ps-4 text-decoration-none", style: "color: #ff6f59;" %>
      <%= link_to "プロフィール", "/users/profile", class: "list-group-item list-group-item-action py-4 ps-4 text-decoration-none" %>
    </div>
  </div>

  <div class="w-100">
    <div class="d-flex justify-content-between border-bottom">
      <h3>アカウント</h3>
    </div>

    <div class="pt-4">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="field d-flex row align-items-center">
          <p class="col-3"><%= f.label :email, "メールアドレス" %></p>
          <p class="col-9"><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-lg" %></p>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
        <% end %>

        <div class="field d-flex row align-items-center">
          <p class="col-3"><%= f.label :password,"変更後パスワード" %><br><small>※変更する場合のみ</small></p>
          <p class="col-9"><%= f.password_field :password, autocomplete: "new-password", class: "form-control form-control-lg" %></p>
        </div>

        <div class="field d-flex row align-items-center">
          <p class="col-3"><%= f.label :password_confirmation, "確認用パスワード" %><br><small>※変更する場合のみ</small></p>
          <p class="col-9"><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control form-control-lg" %></p>
        </div>

        <div class="field d-flex row align-items-center">
          <p class="col-3"><%= f.label :current_password, "現在のパスワード" %></p>
          <p class="col-9"><%= f.password_field :current_password, autocomplete: "current-password", class: "form-control form-control-lg" %></p>
        </div>
        
        <div class="d-flex justify-content-end">
          <div style= "width: 130px;">
            <%= link_to "キャンセル", :back, class: "text-decoration-none text-black form-control form-control-lg text-center" %>        
          </div>
          <div class="actions">
            <%= f.submit "保存", style: "background-color: #ff7f50; width: 100px; height: 48px;", class: "btn text-white ms-2" %>
          </div>
        </div>
      <% end %>


    </div>

  </div>
</div>
